{
  "name": "SEO Image Auditor",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Audit SEO and image best practices on any page.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "assets/icons/icon48.png"
  }
}
